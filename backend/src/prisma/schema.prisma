generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== CORE ====================

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String?
  displayName       String?
  avatarUrl         String?
  provider          String   @default("local")
  providerId        String?
  reputationScore   Int      @default(100)
  subscriptionTier  String   @default("free")
  videoChatsUsed    Int      @default(0)
  videoChatsLimit   Int      @default(5)
  isBanned          Boolean  @default(false)
  banUntil          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  stripeCustomerId  String?
  stripeSubscriptionId String?
  subscriptionStatus String  @default("inactive")
  totalSessions     Int      @default(0)
  positiveRatings   Int      @default(0)
  negativeRatings   Int      @default(0)
  banReason         String?

  sessionsAsA       Session[] @relation("UserA")
  sessionsAsB       Session[] @relation("UserB")
  refreshTokens     RefreshToken[]
  reportsMade       Report[] @relation("Reporter")
  reportsReceived   Report[] @relation("Reported")
  reputationEvents  ReputationEvent[]
  interests         UserInterest[]

  @@index([email])
  @@index([provider, providerId])
  @@index([isBanned])
  @@index([subscriptionTier])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

model Session {
  id                String   @id @default(uuid())
  roomId            String   @unique
  userAId           String
  userBId           String
  mode              String
  startedAt         DateTime @default(now())
  endedAt           DateTime?
  terminationReason String?
  createdAt         DateTime @default(now())
  durationSeconds   Int?
  rating            Int?
  ratingTags        String[]

  userA             User     @relation("UserA", fields: [userAId], references: [id])
  userB             User     @relation("UserB", fields: [userBId], references: [id])
  messages          ChatMessage[]
  reports           Report[]

  @@index([roomId])
  @@index([userAId])
  @@index([userBId])
  @@index([endedAt])
  @@index([startedAt])
  @@index([createdAt])
  @@map("sessions")
}

model ChatMessage {
  id          String   @id @default(uuid())
  sessionId   String
  senderId    String
  text        String   @db.VarChar(2000)
  type        String   @default("text")
  censored    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([senderId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("chat_messages")
}

// ==================== AUTH ====================

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

// ==================== MODERATION ====================

model Report {
  id          String   @id @default(uuid())
  sessionId   String
  reporterId  String
  reportedId  String
  reason      String
  description String?  @db.VarChar(1000)
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  reviewedAt  DateTime?
  resolution  String?
  chatLog     String?

  session     Session  @relation(fields: [sessionId], references: [id])
  reporter    User     @relation("Reporter", fields: [reporterId], references: [id])
  reported    User     @relation("Reported", fields: [reportedId], references: [id])

  @@index([sessionId])
  @@index([reporterId])
  @@index([reportedId])
  @@index([status])
  @@index([createdAt])
  @@map("reports")
}

model ReputationEvent {
  id          String   @id @default(uuid())
  userId      String
  type        String
  points      Int
  change      Int      @default(0)
  description String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("reputation_events")
}

// ==================== INTERESTS ====================

model Interest {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String?
  createdAt   DateTime @default(now())

  users       UserInterest[]

  @@index([name])
  @@index([category])
  @@map("interests")
}

model UserInterest {
  id          String   @id @default(uuid())
  userId      String
  interestId  String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest    Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([userId, interestId])
  @@index([userId])
  @@index([interestId])
  @@map("user_interests")
}

// ==================== AUDIT & COMPLIANCE ====================

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  userId      String?
  ipAddress   String
  userAgent   String
  description String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
