    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/throttler": "^5.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "nestjs-pino": "^4.0.0",
