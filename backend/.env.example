# ==================== REQUIRED ====================
NODE_ENV=production
PORT=4000

# Database
DATABASE_URL=postgresql://amigal:STRONG_PASSWORD@localhost:5432/amigal?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (min 256 bits / 32 bytes)
JWT_SECRET=change-this-to-a-64-character-random-string-minimum-length-required

# ==================== SECURITY ====================
FRONTEND_URL=https://app.amigal.com
ALLOWED_ORIGINS=https://app.amigal.com,https://www.amigal.com

# CORS / CSRF
CSRF_SECRET=another-64-char-random-string-for-csrf-signing

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# WebRTC TURN
TURN_SERVER_URL=turns:turn.amigal.com:5349
TURN_USERNAME=amigal
TURN_CREDENTIAL=strong-turn-password

# ==================== OPTIONAL ====================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Logging
LOG_LEVEL=warn
