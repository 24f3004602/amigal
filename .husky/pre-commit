#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run lint-staged
npx lint-staged

# Type check
echo "📝 Type checking..."
npm run typecheck --workspaces

# Run affected tests (skip if script missing)
echo "🧪 Running affected tests..."
npm run test:changed --workspaces --if-present
