# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app/backend

RUN apk add --no-cache python3 make g++

# Copy backend package files (build context is repo root) - separate layer for caching
COPY backend/package*.json ./
RUN npm ci --frozen-lockfile

# Copy all backend source code
COPY backend/ ./

# Combine Prisma generation and build to reduce layers
RUN npx prisma generate --schema=./src/prisma/schema.prisma && \
    npm run build

# Stage 2: Production
FROM node:20-alpine AS production

WORKDIR /app/backend

ENV NODE_ENV=production \
    NODE_OPTIONS="--max-old-space-size=512"

# Install minimal runtime dependencies (curl for healthcheck)
RUN apk add --no-cache curl

COPY backend/package*.json ./

# Install only production dependencies with frozen lockfile
RUN npm ci --frozen-lockfile --omit=dev && \
    npm install prisma --omit=dev --ignore-scripts && \
    npm cache clean --force

COPY --from=builder /app/backend/dist ./dist
COPY --from=builder /app/backend/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/backend/src/prisma ./src/prisma

# Create non-root user for security
RUN addgroup -g 1001 -S nodeapp && adduser -S nodeapp -u 1001 && \
    mkdir -p /app/logs && chown -R nodeapp:nodeapp /app

USER nodeapp

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD curl -f http://localhost:4000/health/liveness || exit 1

CMD ["node", "dist/main"]
