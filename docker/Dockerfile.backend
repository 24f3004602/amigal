# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Prevent husky/git-hook install scripts from running in CI/Docker (no .git present)
ENV HUSKY=0

RUN apk add --no-cache python3 make g++

# Install full workspace dependencies using root lockfile (monorepo-aware)
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json
COPY packages ./packages
RUN npm ci --frozen-lockfile

# Copy backend source code and build
COPY backend/ ./backend/
WORKDIR /app/backend
RUN npx prisma generate --schema=./src/prisma/schema.prisma && \
    npm run build

# Prune devDependencies in-place (avoids re-running npm ci/husky in production stage)
WORKDIR /app
RUN npm prune --omit=dev --workspace=amigal-backend --include-workspace-root

# Stage 2: Production
FROM node:20-alpine AS production

WORKDIR /app

ENV NODE_ENV=production \
    NODE_OPTIONS="--max-old-space-size=512"

# Install minimal runtime dependencies (curl for healthcheck)
RUN apk add --no-cache curl

# Create non-root user for security
RUN addgroup -g 1001 -S nodeapp && adduser -S nodeapp -u 1001 && \
    mkdir -p /app/logs && chown nodeapp:nodeapp /app/logs

# Copy pruned production node_modules and built app from builder (chown during copy, avoids slow recursive chown)
COPY --from=builder --chown=nodeapp:nodeapp /app/node_modules ./node_modules
COPY --from=builder --chown=nodeapp:nodeapp /app/package.json ./package.json
COPY --from=builder --chown=nodeapp:nodeapp /app/backend/package.json ./backend/package.json
COPY --from=builder --chown=nodeapp:nodeapp /app/backend/dist ./backend/dist
COPY --from=builder --chown=nodeapp:nodeapp /app/backend/src/prisma ./backend/src/prisma

USER nodeapp

WORKDIR /app/backend

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD curl -f http://localhost:4000/health/liveness || exit 1

CMD ["node", "dist/main"]
