# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app/backend

RUN apk add --no-cache python3 make g++

# Copy backend package files (build context is repo root)
COPY backend/package*.json ./
RUN npm ci

# Copy all backend source code
COPY backend/ ./
RUN npx prisma generate --schema=./src/prisma/schema.prisma
RUN npm run build

# Stage 2: Production
FROM node:20-alpine AS production

WORKDIR /app/backend

ENV NODE_ENV=production

RUN apk add --no-cache wget

COPY backend/package*.json ./
RUN HUSKY=0 npm ci --omit=dev --ignore-scripts && npm install prisma --no-save --ignore-scripts && npm cache clean --force

COPY --from=builder /app/backend/dist ./dist
COPY --from=builder /app/backend/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/backend/src/prisma ./src/prisma

RUN mkdir -p /app/logs

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:4000/health/liveness || exit 1

CMD ["sh", "-c", "npx prisma migrate deploy --schema=./src/prisma/schema.prisma && node dist/main"]